{
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git",
        "ref": "v2.2.3"
      }
    }
  },
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh api -X PUT repos/ahzeems/Zeemrepo/pulls/*/merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude/block-pr-merge.ts\""
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/.claude/rules/ecc/angular/**",
    "**/.claude/rules/ecc/arkts/**",
    "**/.claude/rules/ecc/cpp/**",
    "**/.claude/rules/ecc/csharp/**",
    "**/.claude/rules/ecc/dart/**",
    "**/.claude/rules/ecc/fsharp/**",
    "**/.claude/rules/ecc/golang/**",
    "**/.claude/rules/ecc/java/**",
    "**/.claude/rules/ecc/kotlin/**",
    "**/.claude/rules/ecc/nuxt/**",
    "**/.claude/rules/ecc/perl/**",
    "**/.claude/rules/ecc/php/**",
    "**/.claude/rules/ecc/react/**",
    "**/.claude/rules/ecc/react-native/**",
    "**/.claude/rules/ecc/ruby/**",
    "**/.claude/rules/ecc/rust/**",
    "**/.claude/rules/ecc/swift/**",
    "**/.claude/rules/ecc/vue/**",
    "**/.claude/rules/ecc/web/**"
  ]
}
