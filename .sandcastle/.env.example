# Copy to .sandcastle/.env (git-ignored) and fill in. Never commit the filled-in file.
# Agent credential: the output of `claude setup-token` on the host (it starts with sk-ant-oat).
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key instead:
# ANTHROPIC_API_KEY=
# GitHub token for the gh CLI in the sandbox: fine-grained, one repository, Issues read and write only.
GH_TOKEN=
